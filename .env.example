# Local-first setup: Ollama must be installed and running on the computer running CampusVerse.
CAMPUSVERSE_BACKEND=ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
# Single-user local mode: keeps all chats/memories under one fixed visitor id on this computer.
# Leave this line OUT (or empty) on a public deployment so every browser gets its own private data.
CAMPUSVERSE_SINGLE_USER_ID=local
# Optional hosted fallback (not required for local operation):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
